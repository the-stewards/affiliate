# Neon Postgres — use the POOLED connection string (hostname contains "-pooler")
# Neon dashboard > your project > Connection Details > toggle "Pooled connection"
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Zapier — Settings > Zaps > create a Zap with a "Catch Hook" trigger, paste that URL here.
# Fires "new_rsvp" events only (see lib/zapier.ts for the payload shape).
# new_affiliate events go to AFFILIATE_ZAPIER_WEBHOOK_URL below instead — they
# used to share this URL, which ran every affiliate signup through this Zap's
# rsvp_*-shaped steps and wrote mismapped data into the RSVP sheet/CRM.
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxxxxxx/xxxxxxx/

# Zapier — separate Zap/webhook, "new_affiliate" events only. Keep this Zap's
# steps built around affiliate_* fields (see app/api/affiliates/route.ts),
# never rsvp_* fields.
AFFILIATE_ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxxxxxx/xxxxxxx/

# GoHighLevel — in a GHL workflow, add an "Inbound Webhook" trigger and paste
# the URL it gives you here. Delivered independently of (and in addition to)
# Zapier above — both, either, or neither can be set. Still fires for BOTH
# "new_rsvp" and "new_affiliate" (not yet split like Zapier above) - the
# workflow behind this URL was built around the RSVP payload shape and an
# RSVP-confirmation SMS, so affiliate signups likely hit it with mismapped
# fields the same way they used to hit the RSVP Zap. Worth splitting the same
# way if that workflow also branches on event type.
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/xxxxxxx/webhook-trigger/xxxxxxx
