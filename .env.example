# Neon Postgres — use the POOLED connection string (hostname contains "-pooler")
# Neon dashboard > your project > Connection Details > toggle "Pooled connection"
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Zapier — Settings > Zaps > create a Zap with a "Catch Hook" trigger, paste that URL here.
# Fires two event types: "new_rsvp" and "new_affiliate" (see lib/zapier.ts for the payload shape).
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxxxxxx/xxxxxxx/

# GoHighLevel — in a GHL workflow, add an "Inbound Webhook" trigger and paste
# the URL it gives you here. Delivered independently of (and in addition to)
# Zapier above — both, either, or neither can be set. Same two event types
# and payload shape as Zapier; use a "Create/Update Contact" action inside
# the workflow to get the RSVP into GHL, then chain the SMS action after it.
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/xxxxxxx/webhook-trigger/xxxxxxx
